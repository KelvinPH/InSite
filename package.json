{
  "name": "insite",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test && cd plugins/insite-connector && php vendor/bin/phpunit",
    "db:generate": "pnpm --filter @insite/db generate",
    "db:migrate": "pnpm --filter @insite/db migrate",
    "db:push": "pnpm --filter @insite/db push",
    "db:studio": "pnpm --filter @insite/db studio"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  }
}
